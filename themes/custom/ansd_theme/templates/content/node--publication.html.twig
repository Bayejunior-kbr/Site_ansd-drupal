<article{{ attributes.addClass('ansd-pub-detail') }}>

  <h1 class="ansd-pub-title">{{ label }}</h1>

  <div class="ansd-pub-layout">

    <div class="ansd-pub-main">
      <h2>Dernière information</h2>
      <div class="ansd-pub-resume">
        {{ content.field_resume }}
      </div>
    </div>

    <aside class="ansd-pub-sidebar">

      {% if content.field_derniere_publication %}
        <p><strong>Dernière publication :</strong> {{ content.field_derniere_publication|render|striptags|trim }}</p>
      {% endif %}

      {% if content.field_date_publication %}
        <p><strong>Prochaine parution :</strong> {{ content.field_date_publication|render|striptags|trim }}</p>
      {% endif %}

      <hr>

      {% if content.field_date_mise_en_ligne %}
        <p><strong>Date de mise en ligne :</strong> {{ content.field_date_mise_en_ligne|render|striptags|trim }}</p>
      {% endif %}

      {% if not node.field_field_document_pdf_fichier.isEmpty %}
  <p>
    <strong>VERSION IMPRIMABLE</strong><br>
    {% for item in node.field_field_document_pdf_fichier %}
      <a href="{{ file_url(item.entity.fileuri) }}" download target="_blank" rel="noopener noreferrer">
        {{ item.description|default('Télécharger') }}
      </a>{% if not loop.last %}<br>{% endif %}
    {% endfor %}
  </p>
{% endif %}

      {% if not node.field_rapports_archives_pdf.isEmpty %}
  <div class="ansd-pub-archives">
    <button type="button" class="ansd-pub-archives__toggle">
      Rapports et analyses
    </button>
    <div class="ansd-pub-archives__list">
      {% for item in node.field_rapports_archives_pdf %}
        <a href="{{ file_url(item.entity.fileuri) }}" target="_blank" rel="noopener noreferrer">
          {{ item.description|default('Télécharger') }}
        </a>
      {% endfor %}
    </div>
  </div>
{% endif %}

      {% if not node.field_donnees_pdf.isEmpty %}
  <div class="ansd-pub-archives">
    <button type="button" class="ansd-pub-archives__toggle">
      Données
    </button>
    <div class="ansd-pub-archives__list">
      {% for item in node.field_donnees_pdf %}
        <a href="{{ file_url(item.entity.fileuri) }}" target="_blank" rel="noopener noreferrer">
          {{ item.description|default('Télécharger') }}
        </a>
      {% endfor %}
    </div>
  </div>
{% endif %}

      {% if not node.field_documents_de_reference_pdf.isEmpty %}
  <div class="ansd-pub-archives">
    <button type="button" class="ansd-pub-archives__toggle">
      Documents de référence
    </button>
    <div class="ansd-pub-archives__list">
      {% for item in node.field_documents_de_reference_pdf %}
        <a href="{{ file_url(item.entity.fileuri) }}" target="_blank" rel="noopener noreferrer">
          {{ item.description|default('Télécharger') }}
        </a>
      {% endfor %}
    </div>
  </div>
{% endif %}

      {% if content.field_themes_similaires %}
    <div class="ansd-pub-archives">
      <button type="button" class="ansd-pub-archives__toggle">
        Thèmes similaires
      </button>
      <div class="ansd-pub-archives__list">
        {{ content.field_themes_similaires }}
      </div>
    </div>
  {% endif %}

    </aside>

  </div>

    {% if not node.field_graphe_iframe.isEmpty %}
    <div class="ansd-pub-graphe">
      <h2>Graphe indicateur</h2>
      <div class="ansd-pub-graphe__embed">
        {{ content.field_graphe_iframe }}
      </div>
    </div>
  {% endif %}

  {% if content.field_presentation %}
    <div class="ansd-pub-presentation">
      <h2>Présentation de la publication</h2>
      {{ content.field_presentation }}
    </div>
  {% endif %}


</article>