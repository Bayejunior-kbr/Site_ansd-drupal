{% import _self as menus %}
{{ menus.menu_links(items, attributes, 0) }}
{% macro menu_links(items, attributes, menu_level) %}
  {% import _self as menus %}
  {% if items %}
    {% if menu_level == 0 %}
      <ul{{ attributes.addClass('ansd-menu-root') }}>
    {% else %}
      <ul class="ansd-submenu">
    {% endif %}
    {% for item in items %}
      <li{{ item.attributes.addClass('ansd-menu-item') }}>
        <a href="{{ item.url }}"{% if item.url.isExternal %} target="_blank" rel="noopener noreferrer"{% endif %}{% if item.in_active_trail %} class="is-active"{% endif %}>{{ item.title }}</a>
        {% if item.below %}
          {{ menus.menu_links(item.below, attributes, menu_level + 1) }}
        {% endif %}
      </li>
    {% endfor %}
    </ul>
  {% endif %}
{% endmacro %}