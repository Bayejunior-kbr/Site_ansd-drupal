{% if node.bundle == 'page' %}
  <article class="ansd-page ansd-presentation">
    <header class="ansd-presentation__hero">
      <div class="ansd-presentation__hero-content">
        <p class="ansd-presentation__eyebrow">À propos de l’ANSD</p>
        <h1>{{ label }}</h1>
      </div>
    </header>

    <section class="ansd-reveal">
  <div class="ansd-reveal__inner">
    {{ content.field_texte_des_missions }}
  </div>
</section>

    {{ content }}
  </article>
{% else %}
  <article class="ansd-node-publication">
    <div class="ansd-node-publication__cover">{{ content.field_couverture }}</div>
    <div class="ansd-node-publication__body">
      {% if content.field_nouveaute %}<div class="ansd-node-publication__badge">{{ content.field_nouveaute }}</div>{% endif %}
      <h1 class="ansd-node-publication__title">{{ label }}</h1>
      <div class="ansd-node-publication__summary">{{ content.field_resume }}</div>
      {% if content.field_lien_rapport %}<div class="ansd-node-publication__action">{{ content.field_lien_rapport }}</div>{% endif %}
    </div>
  </article>
{% endif %}